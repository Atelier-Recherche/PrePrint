{
	"name": "preprint",
	"version": "1.0.0",
	"description": "Préparation typographique française pour l'édition et le print dans Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test tests/**/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"typography",
		"french"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	}
}
